# ── Core ──────────────────────────────────────────────────────────────────────
TOKEN="your_discord_bot_token"

# Fallback display name, used only where the client isn't available yet.
# Anything running with the client uses the bot account's own Discord name.
brand_name=""

# ── Owners ────────────────────────────────────────────────────────────────────
# Comma-separated Discord user IDs. Empty falls back to the deployment owner in
# utils/config.py (amrcooked / 631428835405070347); set values here to override.
OWNER_IDS="631428835405070347"

# Owner's Discord username, shown where an ID alone is all we have.
OWNER_NAME="amrcooked"

# ── Optional links ────────────────────────────────────────────────────────────
# When SUPPORT_SERVER is empty, support links are simply left out of messages.
SUPPORT_SERVER=""
SUPPORT_CHANNEL=""

# ── Application emoji sync ────────────────────────────────────────────────────
# Uploads missing emojis from utils/emoji.py and patches their IDs on startup.
EMOJI_SYNC="true"

# ── Optional logging webhooks ─────────────────────────────────────────────────
WEBHOOK_URL=""
CMD_WEBHOOK_URL=""

# ── Optional voice-channel counters (leave empty to disable) ──────────────────
SERVER_COUNT_CHANNEL_ID=""
USER_COUNT_CHANNEL_ID=""

# ── Optional: channel that logs when the bot joins a server ───────────────────
LOG_CHANNEL_ID=""
