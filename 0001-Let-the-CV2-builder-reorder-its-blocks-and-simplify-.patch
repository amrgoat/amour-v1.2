From 28458ca6e1186accc2d472b563456b28fd9181bf Mon Sep 17 00:00:00 2001
From: amrgoat <631428835405070347@users.noreply.github.com>
Date: Sat, 17 Oct 2026 08:27:50 +0000
Subject: [PATCH] Let the CV2 builder reorder its blocks and simplify the
 developer credit

Managing a block could only edit or remove it, so building a layout in the
right order meant deleting and re-adding components. The per-block panel now
carries Move up / Move down, which swap neighbours in place, refresh the
builder card and keep the panel on the same block, with bounds disabled and a
safe path when a block was removed elsewhere.

The mention card's developer section listed numbered owner IDs; it now renders
a single masked link so the configured owner name is what people see.
---
 bot/cogs/commands/cv2.py   | 58 ++++++++++++++++++++++++++++++++++++--
 bot/cogs/events/mention.py | 17 ++++++-----
 2 files changed, 63 insertions(+), 12 deletions(-)

diff --git a/bot/cogs/commands/cv2.py b/bot/cogs/commands/cv2.py
index 5bc0989..df64570 100644
--- a/bot/cogs/commands/cv2.py
+++ b/bot/cogs/commands/cv2.py
@@ -464,6 +464,8 @@ class OverwriteView(ui.View):
 
 
 class BlockActionsView(ui.View):
+    """Controls for one block: edit, remove, and move it inside the container."""
+
     def __init__(self, builder: "CV2Builder", index: int):
         super().__init__(timeout=120)
         self.builder = builder
@@ -479,10 +481,29 @@ class BlockActionsView(ui.View):
         remove.callback = self.remove_block
         self.add_item(remove)
 
+        total = len(builder.data["blocks"])
+        up = ui.Button(
+            label="Move up", style=discord.ButtonStyle.secondary, disabled=index <= 0
+        )
+        up.callback = self.move_up
+        self.add_item(up)
+
+        down = ui.Button(
+            label="Move down",
+            style=discord.ButtonStyle.secondary,
+            disabled=index >= total - 1,
+        )
+        down.callback = self.move_down
+        self.add_item(down)
+
         cancel = ui.Button(label="Close", style=discord.ButtonStyle.secondary)
         cancel.callback = self.close
         self.add_item(cancel)
 
+    def status(self) -> str:
+        total = len(self.builder.data["blocks"])
+        return f"Managing block `{self.index + 1:02d}` of `{total:02d}`."
+
     async def interaction_check(self, interaction: discord.Interaction) -> bool:
         if interaction.user.id != self.builder.ctx.author.id:
             await interaction.response.send_message(
@@ -491,6 +512,38 @@ class BlockActionsView(ui.View):
             return False
         return True
 
+    async def _shift(self, interaction: discord.Interaction, offset: int) -> None:
+        """Swap this block with its neighbour and keep the panel on the same block."""
+        blocks = self.builder.data["blocks"]
+        if not 0 <= self.index < len(blocks):
+            # The panel is stale: the block was removed somewhere else.
+            await interaction.response.edit_message(
+                content="That block no longer exists.", view=None
+            )
+            return
+
+        target = self.index + offset
+        if not 0 <= target < len(blocks):
+            # Already at the top or bottom; just re-render with fresh button states.
+            await interaction.response.edit_message(
+                content=self.status(), view=BlockActionsView(self.builder, self.index)
+            )
+            return
+
+        blocks[self.index], blocks[target] = blocks[target], blocks[self.index]
+        self.index = target
+
+        await self.builder.refresh()
+        await interaction.response.edit_message(
+            content=self.status(), view=BlockActionsView(self.builder, self.index)
+        )
+
+    async def move_up(self, interaction: discord.Interaction):
+        await self._shift(interaction, -1)
+
+    async def move_down(self, interaction: discord.Interaction):
+        await self._shift(interaction, 1)
+
     async def edit_block(self, interaction: discord.Interaction):
         kind = self.builder.data["blocks"][self.index]["type"]
         if kind == "text":
@@ -670,10 +723,9 @@ class CV2Builder(ui.LayoutView):
                 "That block no longer exists.", ephemeral=True
             )
             return
+        panel = BlockActionsView(self, index)
         await interaction.response.send_message(
-            f"Managing block `{index + 1:02d}`.",
-            view=BlockActionsView(self, index),
-            ephemeral=True,
+            panel.status(), view=panel, ephemeral=True
         )
 
     async def pick_channel(self, interaction: discord.Interaction):
diff --git a/bot/cogs/events/mention.py b/bot/cogs/events/mention.py
index df2d774..348233a 100644
--- a/bot/cogs/events/mention.py
+++ b/bot/cogs/events/mention.py
@@ -1,6 +1,6 @@
 from utils.branding import bot_invite, bot_name, support_link, user_link
 from utils import getConfig
-from utils.config import OWNER_IDS
+from utils.config import OWNER_IDS, OWNER_NAME
 import discord
 from utils.emoji import ARROWRED, CODEBASE, HEART3, INDEX, ZYROXLINKS
 from discord.ui import LayoutView, TextDisplay, Separator, Container, ActionRow, Select
@@ -67,14 +67,13 @@ class MentionSelectView(LayoutView):
                 f"___Type `{self.prefix}help` for more information.___"
             )
         elif selected == "Developer Info":
-            owners = (
-                "\n".join(
-                    f"**[{index:02d}]. {user_link(owner_id)}**"
-                    for index, owner_id in enumerate(OWNER_IDS, start=1)
-                )
-                or "_No owners configured yet._"
-            )
-            content = f"Thanks to the people who build and run me. 💞\n\n**Owners**\n{owners}"
+            # One plain masked link per owner: [name](https://discord.com/users/<id>)
+            single = len(OWNER_IDS) == 1
+            owners = ", ".join(
+                user_link(owner_id, OWNER_NAME if single else None)
+                for owner_id in OWNER_IDS
+            ) or "_No owners configured yet._"
+            content = f"Developed by {owners}"
         elif selected == "Links":
             content = (
                 f"**[Invite {bot_name(self.bot)}]({bot_invite(self.bot)})**\n"
